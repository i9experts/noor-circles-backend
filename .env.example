# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/noor_circle

# ── Frontend URLs (comma-separated for CORS) ──────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com

# ── JWT Secrets — generate with: node -e "require('crypto').randomBytes(32).toString('hex')" ──
JWT_ACCESS_SECRET=<min_32_char_hex_string>
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=<different_32_char_hex_string>
JWT_REFRESH_EXPIRES_IN=7d

JWT_RESET_SECRET=<another_32_char_hex_string>
JWT_RESET_EXPIRES_IN=10m

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10

# ── Mail (Gmail SMTP) ─────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-gmail-app-password
MAIL_FROM="Noor Circle <your-email@gmail.com>"

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Green API WhatsApp ────────────────────────────────────────────────────────
GREEN_API_INSTANCE_ID=your_instance_id
GREEN_API_TOKEN=your_api_token

# ── Swagger (optional — enable in production if needed) ───────────────────────
ENABLE_SWAGGER=false

# ── Admin Seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=StrongPassword@2026!
