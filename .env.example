# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/noor_circle

# ── Frontend URLs (comma-separated for CORS) ──────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com

# ── JWT Secrets — generate with: node -e "require('crypto').randomBytes(32).toString('hex')" ──
JWT_ACCESS_SECRET=<min_32_char_hex_string>
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=<different_32_char_hex_string>
JWT_REFRESH_EXPIRES_IN=7d

JWT_RESET_SECRET=<another_32_char_hex_string>
JWT_RESET_EXPIRES_IN=10m

# ── OTP ───────────────────────────────────────────────────────────────────────
# Local development only: echo OTPs in API responses. Ignored when NODE_ENV=production.
# NEVER set this on a deployed server.
EXPOSE_OTP_IN_RESPONSE=false
OTP_EXPIRES_MINUTES=10

# ── Mail (Hostinger mailbox: support@noorcircles.com) ─────────────────────────
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=support@noorcircles.com
MAIL_PASS=your-mailbox-password
MAIL_FROM="Noor Circles <support@noorcircles.com>"
# Optional: where replies go (default: the sender), gap between emails in ms
# (default 2000) and how many may be sent in 24 hours (default 800).
# MAIL_REPLY_TO=support@noorcircles.com
# MAIL_RATE_MS=2000
# MAIL_DAILY_LIMIT=800

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Green API WhatsApp ────────────────────────────────────────────────────────
GREEN_API_INSTANCE_ID=your_instance_id
GREEN_API_TOKEN=your_api_token

# ── Swagger (optional — enable in production if needed) ───────────────────────
ENABLE_SWAGGER=false

# ── Admin Seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=StrongPassword@2026!
