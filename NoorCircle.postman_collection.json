{
  "info": {
    "name": "Noor Circle API — Production",
    "description": "Complete API collection for Noor Circle backend. Base URL: {{baseUrl}}\n\n**Setup:**\n1. Set `baseUrl` = `http://localhost:3000/api/v1`\n2. Run **Auth > Sign In** → `accessToken` is auto-saved\n3. All protected routes use `Bearer {{accessToken}}` automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "accessToken",  "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [

    {
      "name": "01 · Auth",
      "item": [
        {
          "name": "Request Signup OTP",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/signup/request-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test@1234\"\n}" }
          }
        },
        {
          "name": "Verify Signup OTP",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/signup/verify-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\"\n}" }
          }
        },
        {
          "name": "Sign In",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data?.accessToken) {",
            "  pm.collectionVariables.set('accessToken', r.data.accessToken);",
            "  pm.collectionVariables.set('refreshToken', r.data.refreshToken);",
            "}"
          ], "type": "text/javascript" }}],
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/signin",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ahad.aptech1@gmail.com\",\n  \"password\": \"Admin@123\"\n}" }
          }
        },
        {
          "name": "Get Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Refresh Tokens",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data?.accessToken) {",
            "  pm.collectionVariables.set('accessToken', r.data.accessToken);",
            "  pm.collectionVariables.set('refreshToken', r.data.refreshToken);",
            "}"
          ], "type": "text/javascript" }}],
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Forgot Password (send OTP)",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Verify Reset OTP",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/verify-otp",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Reset Password",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/reset-password",
            "body": { "mode": "raw", "raw": "{\n  \"resetToken\": \"<jwt_reset_token>\",\n  \"newPassword\": \"NewPass@123\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Resend OTP",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/resend-otp",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"type\": \"signup\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Logout All Devices",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout-all" }
        }
      ]
    },

    {
      "name": "02 · Admin — Dashboard",
      "item": [
        { "name": "Get Stats", "request": { "method": "GET", "url": "{{baseUrl}}/admin/stats" } },
        { "name": "Get Dashboard Extended", "request": { "method": "GET", "url": "{{baseUrl}}/admin/dashboard/extended" } },
        { "name": "Get All Users", "request": { "method": "GET", "url": "{{baseUrl}}/admin/users" } }
      ]
    },

    {
      "name": "03 · Admin — Murabbis",
      "item": [
        { "name": "Get All Murabbis", "request": { "method": "GET", "url": "{{baseUrl}}/admin/murabbis" } },
        { "name": "Get Murabbis With Stats", "request": { "method": "GET", "url": "{{baseUrl}}/admin/murabbis/with-stats" } },
        {
          "name": "Create Murabbi",
          "request": { "method": "POST", "url": "{{baseUrl}}/admin/murabbis",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Sr. Fatima\",\n  \"email\": \"fatima@example.com\",\n  \"password\": \"Pass@1234\",\n  \"phone\": \"03001234567\",\n  \"address\": \"Karachi, Pakistan\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "Update Murabbi", "request": { "method": "PATCH", "url": "{{baseUrl}}/admin/murabbis/:id",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Sr. Fatima Updated\",\n  \"phone\": \"03009876543\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "Update Murabbi Tier", "request": { "method": "PATCH", "url": "{{baseUrl}}/admin/murabbis/:id/tier",
            "body": { "mode": "raw", "raw": "{\n  \"tier\": 2\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "Activate Murabbi",   "request": { "method": "PATCH",  "url": "{{baseUrl}}/admin/murabbis/:id/activate" } },
        { "name": "Deactivate Murabbi", "request": { "method": "PATCH",  "url": "{{baseUrl}}/admin/murabbis/:id/deactivate" } },
        { "name": "Delete Murabbi",     "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/murabbis/:id" } }
      ]
    },

