      "item": [
        { "name": "Get Page Data (Admin)",   "request": { "method": "GET",    "url": "{{baseUrl}}/training/page-data" } },
        { "name": "Get Active Batch",        "request": { "method": "GET",    "url": "{{baseUrl}}/training/active-batch", "description": "Returns batch only if caller is a candidate" } },
