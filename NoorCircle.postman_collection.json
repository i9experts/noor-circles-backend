        { "name": "Get One Neighbourhood",  "request": { "method": "GET",    "url": "{{baseUrl}}/admin/neighbourhoods/:id" } },
        { "name": "Create Neighbourhood",   "request": { "method": "POST",   "url": "{{baseUrl}}/admin/neighbourhoods",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Gulshan-e-Iqbal\",\n  \"city\": \"Karachi\",\n  \"area\": \"East Karachi\",\n  \"mosques\": \"Masjid Bilal, Masjid Umar\",\n  \"status\": \"active\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "Update Neighbourhood",   "request": { "method": "PATCH",  "url": "{{baseUrl}}/admin/neighbourhoods/:id",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"review\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "Delete Neighbourhood",   "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/neighbourhoods/:id" } },
        { "name": "Get Pipeline",           "request": { "method": "GET",    "url": "{{baseUrl}}/admin/neighbourhoods/pipeline" } },
        { "name": "Create Pipeline Entry",  "request": { "method": "POST",   "url": "{{baseUrl}}/admin/neighbourhoods/pipeline",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Korangi\",\n  \"area\": \"East Karachi\",\n  \"mosqueContact\": \"Masjid Al-Noor\",\n  \"targetCircles\": 2,\n  \"interestLevel\": 60,\n  \"status\": \"in-talks\"\n}", "options": { "raw": { "language": "json" } } }
          }
