        { "name": "Get Student By ID",           "request": { "method": "GET",    "url": "{{baseUrl}}/admin/students/:id" } },
        { "name": "Enroll Student",              "request": { "method": "POST",   "url": "{{baseUrl}}/admin/students/enroll",
