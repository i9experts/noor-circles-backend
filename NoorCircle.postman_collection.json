        { "name": "Update Pipeline Entry",  "request": { "method": "PATCH",  "url": "{{baseUrl}}/admin/neighbourhoods/pipeline/:id",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ready-to-launch\",\n  \"interestLevel\": 90\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "Delete Pipeline Entry",  "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/neighbourhoods/pipeline/:id" } },
        { "name": "Launch Pipeline → Neighbourhood", "request": { "method": "POST", "url": "{{baseUrl}}/admin/neighbourhoods/pipeline/:id/launch" } }
      ]
    },

    {
      "name": "05 · Admin — Circles",
      "item": [
        { "name": "Get Circles Page Data", "request": { "method": "GET",    "url": "{{baseUrl}}/admin/circles/page-data" } },
        { "name": "Get All Circles",       "request": { "method": "GET",    "url": "{{baseUrl}}/admin/circles" } },
        { "name": "Get Circle By ID",      "request": { "method": "GET",    "url": "{{baseUrl}}/admin/circles/:id" } },
        { "name": "Create Circle",         "request": { "method": "POST",   "url": "{{baseUrl}}/admin/circles",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Gulshan Circle 1\",\n  \"neighbourhoodId\": \"<neighbourhood_id>\",\n  \"murabbiId\": \"<murabbi_id>\",\n  \"capacity\": 15\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "Update Circle",         "request": { "method": "PATCH",  "url": "{{baseUrl}}/admin/circles/:id",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Gulshan Circle 1 Updated\",\n  \"capacity\": 20\n}", "options": { "raw": { "language": "json" } } }
          }
